# ---------------------------------------------------------------------------
# SpendSense environment variables. Copy to .env.local and fill in.
# NEXT_PUBLIC_* values are sent to the browser — never put secrets in them.
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API). The publishable key is safe for the browser;
# all data access is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public origin of the app, used to build auth redirect URLs
# (OAuth callback, email confirmation). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---------------------
# Recurring transactions cron (/api/cron/recurring). The secret key bypasses RLS;
# only the cron route uses it. Supabase → Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Any long random string. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Gemini API key for the dashboard AI assistant (Vercel AI SDK reads this name).
# Google AI Studio → Get API key.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Not used yet -------------------------------------------------------------
# Error monitoring.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
