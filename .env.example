# ---------------------------------------------------------------------------
# SpendSense environment variables. Copy to .env.local and fill in.
# NEXT_PUBLIC_* values are sent to the browser — never put secrets in them.
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API). The publishable key is safe for the browser;
# all data access is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public origin of the app, used to build auth redirect URLs
# (OAuth callback, email confirmation). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Later phases (not used yet) --------------------------------------------
# Phase 2: server-only key for the recurring-transactions cron job. NEVER expose.
# SUPABASE_SECRET_KEY=sb_secret_xxx
# Phase 2: shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
# CRON_SECRET=
# Phase 4: Gemini via the Vercel AI SDK.
# GOOGLE_GENERATIVE_AI_API_KEY=
# Phase 5: error monitoring.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
